{
  "data_dir": "data",
  "max_file_mb": 200,
  "max_sheets": 100,
  "max_rows_scanned": 200000,
  "max_columns_scanned": 300,
  "ollama_base_url": "http://127.0.0.1:11434",
  "ollama_timeout_seconds": 300,
  "ollama_connect_timeout_seconds": 8,
  "ollama_retries": 2,
  "ollama_num_ctx": 8192,
  "ollama_temperature": 0.1,
  "model_name_prefixes": [
    "qwen3.5",
    "qwen3",
    "qwen2.5"
  ],
  "max_ai_context_chars": 9000,
  "max_ai_prompt_chars": 11000,
  "max_ai_sheets_per_chunk": 3,
  "ai_chunk_retry_ratio": 0.55,
  "max_ai_rows": 40,
  "max_header_rows": 3,
  "max_stats_rows": 20000,
  "max_frequency_values": 40,
  "max_outliers": 120,
  "monitor_interval_seconds": 1.0,
  "gpu_interval_seconds": 2.5,
  "enable_gpu_monitoring": true,
  "log_level": "INFO",
  "keep_intermediate_json": true,
  "report_format": "xlsx",
  "docx_template": ""
}
